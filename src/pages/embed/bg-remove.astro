---
import Embed from '../../layouts/Embed.astro';
---

<Embed title="contentmint · BG Remover (embed)">
    <section class="rounded-xl p-5 bg-black/40 border border-white/10 space-y-4">
        <h1 class="text-lg font-semibold">BG Remover</h1>
        <input id="bg-file" type="file" accept="image/*" class="cm-input" />
        <button id="bg-run" class="cm-btn" disabled>Run background removal</button>
        <div id="bg-status" class="text-sm opacity-70"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
                <div class="text-xs opacity-60 mb-1">Input</div>
                <canvas id="bg-input" class="w-full rounded-lg bg-white/5"></canvas>
            </div>
            <div>
                <div class="text-xs opacity-60 mb-1">Cutout (transparent)</div>
                <canvas
                    id="bg-output"
                    class="w-full rounded-lg"
                    style="background-image: linear-gradient(45deg, rgba(255,255,255,0.08) 25%, transparent 25%, transparent 75%, rgba(255,255,255,0.08) 75%), linear-gradient(45deg, rgba(255,255,255,0.08) 25%, transparent 25%, transparent 75%, rgba(255,255,255,0.08) 75%); background-size: 20px 20px; background-position: 0 0, 10px 10px;"
                ></canvas>
            </div>
        </div>
        <a id="bg-download" class="cm-btn cm-btn--ghost hidden" download="cutout.png">Download cutout PNG</a>
    </section>

    <style>
        .cm-input {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            padding: 0.5rem 0.75rem;
            color: white;
        }
    </style>

    <script>
        import { removeBackground } from '../../lib/visionPipelines';

        let img: HTMLImageElement | null = null;
        const fileInput = document.getElementById('bg-file') as HTMLInputElement;
        const runBtn = document.getElementById('bg-run') as HTMLButtonElement;
        const status = document.getElementById('bg-status')!;
        const inputCanvas = document.getElementById('bg-input') as HTMLCanvasElement;
        const outputCanvas = document.getElementById('bg-output') as HTMLCanvasElement;
        const download = document.getElementById('bg-download') as HTMLAnchorElement;

        fileInput.addEventListener('change', async () => {
            const f = fileInput.files?.[0];
            if (!f) return;
            img = new Image();
            img.src = URL.createObjectURL(f);
            await img.decode();
            inputCanvas.width = img.width;
            inputCanvas.height = img.height;
            inputCanvas.getContext('2d')!.drawImage(img, 0, 0);
            runBtn.disabled = false;
            status.textContent = `Loaded ${img.width}x${img.height}. Click Run.`;
        });

        runBtn.addEventListener('click', async () => {
            if (!img) return;
            runBtn.disabled = true;
            status.textContent = 'Loading model & running segmentation…';
            try {
                const { cutout } = await removeBackground(img);
                outputCanvas.width = cutout.width;
                outputCanvas.height = cutout.height;
                outputCanvas.getContext('2d')!.drawImage(cutout, 0, 0);
                download.href = outputCanvas.toDataURL('image/png');
                download.classList.remove('hidden');
                status.textContent = `Done (${cutout.width}x${cutout.height}).`;
            } catch (err) {
                status.textContent = `Error: ${(err as Error).message}`;
            } finally {
                runBtn.disabled = false;
            }
        });
    </script>
</Embed>
