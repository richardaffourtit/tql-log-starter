---
import Layout from '../layouts/Layout.astro';
import { TOOLS } from '../lib/tools';
---

<Layout title="contentmint — by g00dweird">
    <div class="flex items-end justify-between flex-wrap gap-4 mb-2">
        <h1 class="tracking-tight text-5xl sm:text-6xl font-extrabold">
            <span class="text-white">content</span><span class="cm-mint">mint</span>
        </h1>
        <span class="opacity-70 text-sm">by g00dweird</span>
    </div>
    <p class="mb-8 text-lg opacity-80">
        A suite of browser-based tools for creating 9:16 vertical music content videos. Pick a tool.
    </p>
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
            TOOLS.map((t) => (
                <li class="rounded-xl border border-white/10 bg-white/5 p-5 space-y-2 hover:bg-white/10 transition-colors">
                    <div class="flex items-start justify-between gap-2">
                        <a href={t.href} class="text-xl font-semibold hover:underline">
                            {t.name}
                        </a>
                        <span
                            class="text-[10px] uppercase tracking-widest px-2 py-0.5 rounded-md"
                            style={`background: ${t.accent}33; color: ${t.accent}; border: 1px solid ${t.accent}66;`}
                        >
                            {t.status}
                        </span>
                    </div>
                    <div class="text-sm opacity-80">{t.tagline}</div>
                    <p class="text-xs opacity-70 leading-relaxed">{t.description}</p>
                    <a href={t.href} class="inline-block text-xs mt-1 opacity-80 hover:opacity-100">
                        Open →
                    </a>
                </li>
            ))
        }
    </ul>
    <style>
        .cm-mint {
            background: linear-gradient(90deg, #7b2bff 0%, #a855f7 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
    </style>
</Layout>
