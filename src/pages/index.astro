---
import Layout from '../layouts/Layout.astro';
import { TOOLS } from '../lib/tools';
---

<Layout title="contentmint — by g00dweird">
    <section class="text-center sm:text-left">
        <h1 class="tracking-tight text-6xl sm:text-7xl font-extrabold mb-4">
            <span class="text-white">content</span><span class="cm-mint">mint</span>
        </h1>
        <p class="opacity-70 text-lg mb-2">by g00dweird</p>
        <p class="text-xl opacity-90 leading-relaxed max-w-2xl mb-8">
            A browser-native studio for 9:16 music content. MIDI · audio · stems → staff-tab /
            piano-roll / waveform / spectrum, cued, cut, and deploy-tagged for TikTok, Reels, and
            Shorts.
        </p>
        <div class="flex flex-wrap gap-3 mb-12">
            <a href="/tools" class="cm-btn">Open the studio →</a>
            <a href="/tools/video-studio" class="cm-btn cm-btn--ghost">Jump to Video Studio</a>
            <a href="/tools/brand-kit" class="cm-btn cm-btn--ghost">Brand Kit</a>
        </div>
    </section>

    <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-4">Tools</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
                TOOLS.map((t) => (
                    <li class="rounded-xl border border-white/10 bg-white/5 p-4 hover:bg-white/10 transition-colors">
                        <a href={t.href} class="block space-y-1">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-lg font-semibold">{t.name}</span>
                                <span
                                    class="text-[10px] uppercase tracking-widest px-2 py-0.5 rounded-md"
                                    style={`background: ${t.accent}33; color: ${t.accent}; border: 1px solid ${t.accent}66;`}
                                >
                                    {t.status}
                                </span>
                            </div>
                            <div class="text-sm opacity-80">{t.tagline}</div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    <style>
        .cm-mint {
            background: linear-gradient(90deg, #7b2bff 0%, #a855f7 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
    </style>
</Layout>
