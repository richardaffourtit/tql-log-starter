---
import Layout from '../../layouts/Layout.astro';
import { TOOLS } from '../../lib/tools';

const tool = TOOLS.find((t) => t.slug === 'lyrics')!;
---

<Layout title={`${tool.name} · contentmint`}>
    <div class="flex items-end justify-between flex-wrap gap-4 mb-2">
        <h1 class="tracking-tight text-4xl sm:text-5xl font-extrabold">
            <span class="text-white">content</span><span class="cm-mint">mint</span>
            <span class="opacity-60 font-normal text-2xl sm:text-3xl ml-3">/ {tool.name}</span>
        </h1>
        <span
            class="text-xs uppercase tracking-widest px-2 py-1 rounded-md"
            style={`background: ${tool.accent}33; color: ${tool.accent}; border: 1px solid ${tool.accent}66;`}
            >{tool.status}</span
        >
    </div>
    <p class="mb-8 text-lg opacity-80">{tool.tagline}</p>

    <section class="rounded-xl p-6 bg-white/5 border border-white/10 space-y-4">
        <h2 class="text-xl font-semibold">What this will do</h2>
        <p class="opacity-80 leading-relaxed">{tool.description}</p>

        <ul class="list-disc pl-6 opacity-80 space-y-1 text-sm">
            <li>Paste lyrics or import an LRC / subtitle file</li>
            <li>Tap-to-time each word or phrase against the audio playhead</li>
            <li>Text mode: styled captions with contentmint type presets + glitch/scan animation</li>
            <li>Image mode: generate a Midjourney Alpha prompt per phrase using the Elements aesthetic pipeline, attach the returned PNGs</li>
            <li>Export as 9:16 WebM (chroma / alpha) so CapCut can stack captions on any cut, synced to the same cue as the Video Studio export</li>
        </ul>

        <div class="mt-4 text-xs opacity-60">
            Stub page — timing grid, text renderer, and Midjourney prompt builder still to build.
        </div>
    </section>

    <a href="/tools" class="cm-btn cm-btn--ghost mt-6 inline-flex">← Back to Video Studio</a>

    <style>
        .cm-mint {
            background: linear-gradient(90deg, #7b2bff 0%, #a855f7 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
    </style>
</Layout>
