---
import Layout from '../../layouts/Layout.astro';
import { TOOLS } from '../../lib/tools';

const tool = TOOLS.find((t) => t.slug === 'depth')!;
---

<Layout title={`${tool.name} · contentmint`}>
    <div class="flex items-end justify-between flex-wrap gap-4 mb-2">
        <h1 class="tracking-tight text-4xl sm:text-5xl font-extrabold">
            <span class="text-white">content</span><span class="cm-mint">mint</span>
            <span class="opacity-60 font-normal text-2xl sm:text-3xl ml-3">/ {tool.name}</span>
        </h1>
        <span
            class="text-xs uppercase tracking-widest px-2 py-1 rounded-md"
            style={`background: ${tool.accent}33; color: ${tool.accent}; border: 1px solid ${tool.accent}66;`}
            >{tool.status}</span
        >
    </div>
    <p class="mb-8 text-lg opacity-80">{tool.tagline}</p>

    <section class="rounded-xl p-6 bg-white/5 border border-white/10 space-y-4 mb-6">
        <p class="opacity-80 leading-relaxed">{tool.description}</p>
        <p class="text-xs opacity-60">
            First run downloads Depth-Anything-Small (~100MB) — subsequent runs are fast. Depth map
            is normalized to [0,255] so it can be used directly as a displacement / DOF / fog mask
            in Scene or CapCut.
        </p>
    </section>

    <section class="rounded-xl p-6 bg-black/40 border border-white/10 space-y-4">
        <input id="depth-file" type="file" accept="image/*" class="cm-input" />
        <button id="depth-run" class="cm-btn" disabled>Estimate depth</button>
        <div id="depth-status" class="text-sm opacity-70"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <div class="text-xs opacity-60 mb-1">Input</div>
                <canvas id="depth-input" class="w-full rounded-lg bg-white/5"></canvas>
            </div>
            <div>
                <div class="text-xs opacity-60 mb-1">Depth (bright = near)</div>
                <canvas id="depth-output" class="w-full rounded-lg bg-black"></canvas>
            </div>
        </div>
        <a id="depth-download" class="cm-btn cm-btn--ghost hidden" download="depth.png">
            Download depth map PNG
        </a>
    </section>

    <a href="/tools" class="cm-btn cm-btn--ghost mt-6 inline-flex">← Back to tools</a>

    <style>
        .cm-mint {
            background: linear-gradient(90deg, #7b2bff 0%, #a855f7 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .cm-input {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            padding: 0.5rem 0.75rem;
            color: white;
        }
    </style>

    <script>
        import { estimateDepth } from '../../lib/visionPipelines';

        let img: HTMLImageElement | null = null;
        const fileInput = document.getElementById('depth-file') as HTMLInputElement;
        const runBtn = document.getElementById('depth-run') as HTMLButtonElement;
        const status = document.getElementById('depth-status')!;
        const inputCanvas = document.getElementById('depth-input') as HTMLCanvasElement;
        const outputCanvas = document.getElementById('depth-output') as HTMLCanvasElement;
        const download = document.getElementById('depth-download') as HTMLAnchorElement;

        fileInput.addEventListener('change', async () => {
            const f = fileInput.files?.[0];
            if (!f) return;
            img = new Image();
            img.src = URL.createObjectURL(f);
            await img.decode();
            inputCanvas.width = img.width;
            inputCanvas.height = img.height;
            inputCanvas.getContext('2d')!.drawImage(img, 0, 0);
            runBtn.disabled = false;
            status.textContent = `Loaded ${img.width}x${img.height}. Click Run.`;
        });

        runBtn.addEventListener('click', async () => {
            if (!img) return;
            runBtn.disabled = true;
            status.textContent = 'Loading Depth-Anything & running…';
            try {
                const { depth } = await estimateDepth(img);
                outputCanvas.width = depth.width;
                outputCanvas.height = depth.height;
                outputCanvas.getContext('2d')!.putImageData(depth, 0, 0);
                download.href = outputCanvas.toDataURL('image/png');
                download.classList.remove('hidden');
                status.textContent = `Done (${depth.width}x${depth.height}).`;
            } catch (err) {
                status.textContent = `Error: ${(err as Error).message}`;
            } finally {
                runBtn.disabled = false;
            }
        });
    </script>
</Layout>
