---
import Layout from '../../layouts/Layout.astro';
import { TOOLS } from '../../lib/tools';
import BrandKitApp from '../../components/tools/BrandKitApp.astro';

const tool = TOOLS.find((t) => t.slug === 'brand-kit')!;
---

<Layout title={`${tool.name} · contentmint`}>
    <div class="flex items-end justify-between flex-wrap gap-4 mb-2">
        <h1 class="tracking-tight text-4xl sm:text-5xl font-extrabold">
            <span class="text-white">content</span><span class="cm-mint">mint</span>
            <span class="opacity-60 font-normal text-2xl sm:text-3xl ml-3">/ {tool.name}</span>
        </h1>
        <span
            class="text-xs uppercase tracking-widest px-2 py-1 rounded-md"
            style={`background: ${tool.accent}33; color: ${tool.accent}; border: 1px solid ${tool.accent}66;`}
            >{tool.status}</span
        >
    </div>
    <p class="mb-8 text-lg opacity-80">{tool.tagline}</p>

    <section class="rounded-xl p-6 bg-white/5 border border-white/10 space-y-4 mb-6">
        <h2 class="text-xl font-semibold">Deploy-ready kit</h2>
        <p class="opacity-80 leading-relaxed">{tool.description}</p>
        <ul class="list-disc pl-6 opacity-80 space-y-1 text-sm">
            <li>Assets: images, GIFs, short video loops, header footage, fonts</li>
            <li>Copy: bio, tagline, per-platform caption templates, CTA lines, lyric quotes, credits</li>
            <li>Links: social, music platforms, merch, press — grouped for linkinbio-style deploys</li>
            <li>Palette lock: the contentmint ink / primary / pink / green / chroma stays in sync across tools</li>
            <li>Export / import the whole kit as JSON — drop it into another browser or share with collaborators</li>
        </ul>
    </section>

    <BrandKitApp />

    <a href="/tools" class="cm-btn cm-btn--ghost mt-6 inline-flex">← Back to tools</a>

    <style>
        .cm-mint {
            background: linear-gradient(90deg, #7b2bff 0%, #a855f7 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
    </style>
</Layout>
