---
import Layout from '../../layouts/Layout.astro';
import { TOOLS } from '../../lib/tools';

const tool = TOOLS.find((t) => t.slug === 'scene')!;
---

<Layout title={`${tool.name} · contentmint`}>
    <div class="flex items-end justify-between flex-wrap gap-4 mb-2">
        <h1 class="tracking-tight text-4xl sm:text-5xl font-extrabold">
            <span class="text-white">content</span><span class="cm-mint">mint</span>
            <span class="opacity-60 font-normal text-2xl sm:text-3xl ml-3">/ {tool.name}</span>
        </h1>
        <span
            class="text-xs uppercase tracking-widest px-2 py-1 rounded-md"
            style={`background: ${tool.accent}33; color: ${tool.accent}; border: 1px solid ${tool.accent}66;`}
            >{tool.status}</span
        >
    </div>
    <p class="mb-8 text-lg opacity-80">{tool.tagline}</p>

    <section class="rounded-xl p-6 bg-white/5 border border-white/10 space-y-3 mb-6">
        <p class="opacity-80 leading-relaxed">{tool.description}</p>
        <ul class="list-disc pl-6 opacity-80 text-sm space-y-1">
            <li>Load a video (your guitar performance, a room, anything with a flat surface)</li>
            <li>
                Click four corners of the flat surface in order (top-left → top-right → bottom-right
                → bottom-left of where you want the overlay to land)
            </li>
            <li>
                Load an overlay image (piano roll capture, lyric still, Midjourney render) — it warps
                onto the plane via CSS <code>matrix3d</code>
            </li>
            <li>
                Hook up BG Remover + Depth Mask to matte the performer out front and push the warp
                behind them
            </li>
            <li>Gaussian splat + GLB model loaders share the same anchor pose (next pass)</li>
        </ul>
    </section>

    <section class="rounded-xl p-6 bg-black/40 border border-white/10 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="text-sm opacity-80 block">
                Video
                <input id="scene-video-file" type="file" accept="video/*" class="cm-input mt-1" />
            </label>
            <label class="text-sm opacity-80 block">
                Overlay (piano roll / image)
                <input
                    id="scene-overlay-file"
                    type="file"
                    accept="image/*"
                    class="cm-input mt-1"
                />
            </label>
        </div>
        <div class="flex gap-2 flex-wrap">
            <button id="scene-play" class="cm-btn">Play</button>
            <button id="scene-pause" class="cm-btn cm-btn--ghost">Pause</button>
            <button id="scene-reset" class="cm-btn cm-btn--ghost">Reset points</button>
            <label class="flex items-center gap-1 text-sm opacity-80">
                <input id="scene-opacity" type="range" min="0" max="1" step="0.05" value="0.85" />
                <span>overlay α</span>
            </label>
            <label class="flex items-center gap-1 text-sm opacity-80">
                <input id="scene-behind" type="checkbox" />
                <span>behind subject (uses bg-remove)</span>
            </label>
        </div>
        <div
            id="scene-stage"
            class="relative w-full rounded-lg overflow-hidden bg-black select-none"
            style="aspect-ratio: 16/9;"
        >
            <video
                id="scene-video"
                class="absolute inset-0 w-full h-full object-contain"
                playsinline
                muted
                loop></video>
            <img
                id="scene-overlay"
                class="absolute top-0 left-0 pointer-events-none"
                style="transform-origin: 0 0; display: none; will-change: transform;"
            />
            <img
                id="scene-matte"
                class="absolute inset-0 w-full h-full object-contain pointer-events-none"
                style="display: none;"
            />
            <svg
                id="scene-markers"
                class="absolute inset-0 w-full h-full pointer-events-auto cursor-crosshair"
                style="touch-action: none;"
            ></svg>
        </div>
        <div id="scene-status" class="text-sm opacity-70">Load a video, then click four points.</div>
    </section>

    <a href="/tools" class="cm-btn cm-btn--ghost mt-6 inline-flex">← Back to tools</a>

    <style>
        .cm-mint {
            background: linear-gradient(90deg, #7b2bff 0%, #a855f7 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .cm-input {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            padding: 0.5rem 0.75rem;
            color: white;
            width: 100%;
        }
    </style>

    <script>
        import { solveHomography, homographyToCssMatrix, type Point2 } from '../../lib/sceneGeometry';
        import { removeBackground } from '../../lib/visionPipelines';

        const video = document.getElementById('scene-video') as HTMLVideoElement;
        const overlay = document.getElementById('scene-overlay') as HTMLImageElement;
        const matte = document.getElementById('scene-matte') as HTMLImageElement;
        const svg = document.getElementById('scene-markers') as unknown as SVGSVGElement;
        const status = document.getElementById('scene-status')!;
        const videoFile = document.getElementById('scene-video-file') as HTMLInputElement;
        const overlayFile = document.getElementById('scene-overlay-file') as HTMLInputElement;
        const playBtn = document.getElementById('scene-play') as HTMLButtonElement;
        const pauseBtn = document.getElementById('scene-pause') as HTMLButtonElement;
        const resetBtn = document.getElementById('scene-reset') as HTMLButtonElement;
        const opacityInput = document.getElementById('scene-opacity') as HTMLInputElement;
        const behindInput = document.getElementById('scene-behind') as HTMLInputElement;

        let points: Point2[] = [];

        videoFile.addEventListener('change', () => {
            const f = videoFile.files?.[0];
            if (!f) return;
            video.src = URL.createObjectURL(f);
            status.textContent = 'Video loaded. Pause on a frame and click four corners of the flat surface.';
        });

        overlayFile.addEventListener('change', async () => {
            const f = overlayFile.files?.[0];
            if (!f) return;
            overlay.src = URL.createObjectURL(f);
            overlay.style.display = 'block';
            await overlay.decode();
            applyWarp();
        });

        playBtn.addEventListener('click', () => void video.play());
        pauseBtn.addEventListener('click', () => video.pause());
        resetBtn.addEventListener('click', () => {
            points = [];
            renderMarkers();
            overlay.style.transform = '';
            status.textContent = 'Reset. Click four corners again.';
        });

        opacityInput.addEventListener('input', () => {
            overlay.style.opacity = opacityInput.value;
        });

        behindInput.addEventListener('change', async () => {
            if (behindInput.checked) {
                status.textContent = 'Running bg-removal on current frame…';
                try {
                    const c = document.createElement('canvas');
                    c.width = video.videoWidth;
                    c.height = video.videoHeight;
                    c.getContext('2d')!.drawImage(video, 0, 0);
                    const { cutout } = await removeBackground(c);
                    matte.src = cutout.toDataURL('image/png');
                    matte.style.display = 'block';
                    status.textContent = 'Matte rendered — overlay now tucks behind the subject.';
                } catch (err) {
                    status.textContent = `Matte error: ${(err as Error).message}`;
                    behindInput.checked = false;
                }
            } else {
                matte.style.display = 'none';
            }
        });

        svg.addEventListener('click', (e) => {
            const rect = svg.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            points.push([x, y]);
            if (points.length > 4) points = points.slice(-4);
            renderMarkers();
            if (points.length === 4) applyWarp();
        });

        function renderMarkers() {
            svg.innerHTML = points
                .map(
                    (p, i) => `
                <circle cx="${p[0]}" cy="${p[1]}" r="6" fill="#ff9a00" stroke="white" stroke-width="2" />
                <text x="${p[0] + 10}" y="${p[1] - 10}" fill="#ff9a00" font-size="14" font-weight="700">${i + 1}</text>
            `
                )
                .join('');
            if (points.length >= 2) {
                const path = points
                    .map((p, i) => (i === 0 ? `M${p[0]},${p[1]}` : `L${p[0]},${p[1]}`))
                    .join(' ');
                svg.innerHTML += `<path d="${path}${points.length === 4 ? ' Z' : ''}" stroke="#ff9a00" fill="#ff9a0033" stroke-width="2" />`;
            }
        }

        function applyWarp() {
            if (points.length !== 4 || !overlay.src) return;
            const w = overlay.naturalWidth || overlay.width || 1920;
            const h = overlay.naturalHeight || overlay.height || 1080;
            const src: Point2[] = [[0, 0], [w, 0], [w, h], [0, h]];
            const h0 = solveHomography(src, points);
            if (!h0) {
                status.textContent = 'Could not solve homography — try less degenerate corners.';
                return;
            }
            overlay.style.width = `${w}px`;
            overlay.style.height = `${h}px`;
            overlay.style.transform = homographyToCssMatrix(h0);
            overlay.style.opacity = opacityInput.value;
            status.textContent = 'Overlay warped to plane.';
        }

        window.addEventListener('resize', () => {
            if (points.length === 4) applyWarp();
        });
    </script>
</Layout>
